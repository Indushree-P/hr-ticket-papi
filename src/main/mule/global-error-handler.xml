	<sub-flow name="common_error_handler" doc:id="4b6fbc8e-95be-4c65-a45b-d0a72a3bd80b" >
		<ee:transform doc:name="error_response" doc:id="436173ba-1850-4c0f-98da-1c7fd3ec2828">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    statusCode: vars.httpStatus,
    correlationId: correlationId,
    errorType: error.errorType.identifier,
    message: error.description
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="log-error-details" doc:id="e99fb51f-9bb5-4ca0-82f0-ed7b3aa1db1a" message="Correlation ID: #[vars.correlationId default correlationId] | Error Type: #[error.errorType.identifier] | Error Message: #[error.description]"/>
	</sub-flow>
</mule>
