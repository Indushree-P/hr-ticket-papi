			<set-variable value="#[400]" doc:name="Variable for httpStatus" doc:id="58256538-74f7-4df2-9b2d-3360f1196dc2" variableName="httpStatus"/>
			<flow-ref doc:name="invoke common error handler" doc:id="4971eb13-4cdb-452f-bff3-0f13e894eb2f" name="common_error_handler"/>
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate1" doc:id="50ab0f61-7c06-4a28-a87c-f404c654e6d2" type="APIKIT:NOT_FOUND" >
			<set-variable value="#[404]" doc:name="Variable for httpStatus" doc:id="b315f2b2-1ccb-46b4-b524-1a51244d1beb" variableName="httpStatus"/>
