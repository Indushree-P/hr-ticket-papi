			<set-variable value="#[400]" doc:name="Variable for httpStatus" doc:id="4961a35f-47f6-4ac9-958f-949eae27859b" variableName="httpStatus" />
			<flow-ref doc:name="invoke common error handler" doc:id="be631266-61d7-44da-95c4-cf404522c008" name="common_error_handler" />
