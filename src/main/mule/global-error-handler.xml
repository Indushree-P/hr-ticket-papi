		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate3" doc:id="773ac77f-3822-4d78-b1e9-5c839dc24790" type="APIKIT:NOT_ACCEPTABLE" >
			<set-variable value="#[406]" doc:name="Variable for httpStatus" doc:id="1b9e0822-f795-405c-9850-847e596c61fe" variableName="httpStatus"/>
