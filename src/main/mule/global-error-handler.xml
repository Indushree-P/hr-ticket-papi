			<set-variable value="#[415]" doc:name="Variable for httpStatus" doc:id="2bc4beda-23a0-48e5-8447-82abe1869b1e" variableName="httpStatus"/>
			<flow-ref doc:name="invoke common error handler" doc:id="62f62a13-b6fb-451c-817b-1ca2c3138fc9" name="common_error_handler" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate5" doc:id="f68300a0-f44c-4e0f-854f-a9cf17d887be" type="APIKIT:NOT_IMPLEMENTED" >
			<set-variable value="#[501]" doc:name="Variable for httpStatus" doc:id="0d38bac7-d4da-4fa9-b797-58b2fbf0aa61" variableName="httpStatus"/>
