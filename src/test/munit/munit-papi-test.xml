		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert Status" doc:id="25aa1c01-782b-4e9d-89a4-3bb89a3618d8" expression="#[payload.status]" is='#[MunitTools::equalTo("TICKET_CREATED")]' />
			<munit-tools:assert-that doc:name="Assert priority" doc:id="3c3f66cd-d241-4fef-9965-019187fd0524" expression="#[payload.priority]" is='#[MunitTools::equalTo("CRITICAL")]' />
			<munit-tools:verify-call doc:name="Verify Alert API Called" doc:id="061ee9bd-2c76-4ca2-b2d4-c4b1289f8bbf" processor="http:request" times="1" >
