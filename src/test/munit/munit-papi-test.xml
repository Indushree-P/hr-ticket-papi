	<munit:test name="critical-ticket-happy-path" doc:id="e941c493-8258-4153-b9b3-6079edc5d6b9" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock ai sapi" doc:id="5083beea-b6c9-4e57-98ac-34312fe5ab29" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="invoke-ai-sapi" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  sentiment: "NEGATIVE",&#10;  priority: "CRITICAL",&#10;  isIssueTypeValid: true&#10;}]' mediaType="application/json" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock db sapi" doc:id="7948f7d6-e699-44ad-89bd-445d4dade933" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="invoke-db-sapi" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[{&#10;  "status": "SUCCESS"&#10;}]' mediaType="application/json" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock alert sapi" doc:id="2fb18a87-7a90-4a1d-ad06-454d20fb05aa" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="invoke-alert-sapi" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[{"alertSent": true}]' mediaType="application/json" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock vm publish" doc:id="57762b9b-73b5-4a53-859a-d725fe9b1359" processor="vm:publish">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="publish-audit-event" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="400c2d78-3438-41ec-b768-1f228654867b" >
				<munit:payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  employeeId: "EMP001",&#10;  department: "HR",&#10;  issueType: "Payroll",&#10;  description: "Salary not credited this month"&#10;}]' mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to post:\process-ticket:application\json:hr-ticket-papi-config" doc:id="7c62a0b7-6da0-44ae-be94-6a41bc277e40" name="post:\process-ticket:application\json:hr-ticket-papi-config"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert Status" doc:id="659362b1-9e66-4e2a-b974-402da445075a" expression="#[payload.status]" is='#[MunitTools::equalTo("TICKET_CREATED")]'/>
			<munit-tools:assert-that doc:name="Assert priority" doc:id="19c5109b-b2c2-47eb-b610-cc2ddd98809c" is='#[MunitTools::equalTo("CRITICAL")]' expression="#[payload.priority]"/>
			<munit-tools:verify-call doc:name="Verify Alert API Called" doc:id="86a14e1f-acea-4bde-b369-a26d51aea915" processor="http:request" times="1">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="invoke-alert-sapi" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			
</munit:validation>
</munit:test>
